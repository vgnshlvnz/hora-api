#!/usr/bin/env bash
# ruff on staged Python files; block date-of-birth-like data in tests/ and data/.
set -u
fail=0

ruff_cmd=(ruff)
command -v uv >/dev/null 2>&1 && ruff_cmd=(uv run ruff)

mapfile -t py_files < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.pyi?$')
if ((${#py_files[@]})); then
  "${ruff_cmd[@]}" check "${py_files[@]}" || fail=1
  "${ruff_cmd[@]}" format --check "${py_files[@]}" || fail=1
fi

# Birth data is personal. Real profiles live outside the repo; only tests/fixtures/ may
# hold synthetic ones. Heuristics: a birth-ish keyword next to a date, or a date/datetime
# in the years 1900-2019 (a 2026 test day is fine). Append 'dob-ok' on a line to allow it.
dob_patterns=(
  '\b(19[0-9]{2}|20[01][0-9])[-/.](0?[1-9]|1[0-2])[-/.](0?[1-9]|[12][0-9]|3[01])\b'
  '\b(0?[1-9]|[12][0-9]|3[01])[-/.](0?[1-9]|1[0-2])[-/.](19[0-9]{2}|20[01][0-9])\b'
  '(dob|date[_ -]?of[_ -]?birth|birth[_ -]?(date|dt|time)|born)\W.*[0-9]{4}[-/.][0-9]{2}[-/.][0-9]{2}'
  'datetime\(\s*(19[0-9]{2}|20[01][0-9])\s*,'
)
hits=""
while IFS= read -r path; do
  case $path in tests/fixtures/*) continue ;; esac
  for pat in "${dob_patterns[@]}"; do
    out=$(git show ":$path" | grep -nEi -e "$pat" | grep -v 'dob-ok' | sed "s|^|  $path:|")
    [[ -n $out ]] && hits+="$out"$'\n'
  done
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '^(tests|data)/')

if [[ -n $hits ]]; then
  {
    echo "pre-commit: possible date of birth in tests/ or data/ (outside tests/fixtures/):"
    printf '%s' "$hits" | sort -u
    echo "Move synthetic profiles to tests/fixtures/, or append 'dob-ok' to a line that is not birth data."
  } >&2
  fail=1
fi

exit $fail
