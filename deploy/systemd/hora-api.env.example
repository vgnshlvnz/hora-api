# Copy to /etc/hora-api/hora-api.env (chmod 640, owner root:hora).

# Interface and port uvicorn listens on. Narrow HORA_BIND to your LAN address if you can.
HORA_BIND=0.0.0.0
HORA_PORT=8000

# Comma-separated API keys; clients send X-API-Key. Generate with: openssl rand -hex 24
API_KEYS=change-me

# Profiles live outside the repo.
PROFILES_PATH=/etc/hora-api/profiles.yaml

# Per-subscriber keys with tiers (optional; manage with hora-keys --file this path).
KEYS_PATH=/etc/hora-api/keys.yaml

# Defaults for requests that omit lat/lon/tz.
DEFAULT_LAT=3.107
DEFAULT_LON=101.606
DEFAULT_TZ=Asia/Kuala_Lumpur
