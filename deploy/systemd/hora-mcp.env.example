# Copy to /etc/hora-api/hora-mcp.env (chmod 640, owner root:hora).

# The API this server wraps, and one of the keys in API_KEYS.
HORA_API_URL=http://127.0.0.1:8000
HORA_API_KEY=change-me

# Where the MCP server listens, and the bearer token clients must send.
HORA_MCP_HOST=0.0.0.0
HORA_MCP_PORT=8765
HORA_MCP_TOKEN=change-me-too
# Host values accepted (what clients type). Empty disables the Host check.
# HORA_MCP_ALLOWED_HOSTS=hora.lan:8765,192.168.1.20:8765
