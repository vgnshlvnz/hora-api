# Copy to deploy/.env (git-ignored) and fill in. Used by docker-compose.yml.

# Host directory holding profiles.yaml (kept outside the repo). Mounted read-only.
PROFILES_DIR=/srv/hora-api/profiles

# Comma-separated API keys; clients send X-API-Key. Generate with: openssl rand -hex 24
API_KEYS=change-me

# MCP access. Choose ONE mode (the MCP server refuses to start without one):
#  shared:      one bearer token for every caller, and the key the server uses upstream
#               (one of API_KEYS). Everyone behind the token has that key's rights.
HORA_API_KEY=change-me
HORA_MCP_TOKEN=change-me-too
#  passthrough: each caller sends its own hora-api key as the bearer token and gets its own
#               tier and profiles. Comment out HORA_MCP_TOKEN and HORA_API_KEY, then:
# HORA_MCP_PASSTHROUGH=true

# Directory holding keys.yaml (per-subscriber keys with tiers; manage with hora-keys). Optional.
# KEYS_DIR=./keys

# Host values MCP accepts (what clients type), comma-separated. Empty disables the Host check.
# Example: hora.lan:8765,192.168.1.20:8765
HORA_MCP_ALLOWED_HOSTS=

# Where the containers publish on the host. Default: all interfaces. Narrow to your LAN address.
# API_PUBLISH=192.168.1.20:8000
# MCP_PUBLISH=192.168.1.20:8765

# Defaults for requests that omit lat/lon/tz.
# DEFAULT_LAT=3.107
# DEFAULT_LON=101.606
# DEFAULT_TZ=Asia/Kuala_Lumpur

# Watcher (restarts unhealthy containers). DOCKER_GID is required: the group that owns the
# Docker socket on this host (stat -c %g /var/run/docker.sock).
DOCKER_GID=999
# Host directory for the watcher's status file (must be writable by uid 10001).
# WATCHER_STATUS_DIR=./watcher-status
# WATCHER_INTERVAL=15
# WATCHER_MAX_RESTARTS=3
# WATCHER_WINDOW=1800
